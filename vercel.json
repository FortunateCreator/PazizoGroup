{
  "buildCommand": "pip install -r requirements.txt 2>&1 | tail -3",
  "outputDirectory": ".",
  "functions": {
    "api/index.py": {
      "runtime": "python3.11",
      "maxDuration": 30
    }
  },
  "routes": [
    { "src": "/static/(.*)", "dest": "/api/static/$1", "headers": {"cache-control": "public, max-age=31536000, immutable"} },
    { "src": "/favicon.ico", "dest": "/favicon.ico" },
    { "src": "/(.*\\.(css|js|png|jpg|svg|ico|webp))", "dest": "/$1" },
    { "src": "/landing", "dest": "/api/index" },
    { "src": "/login", "dest": "/api/index" },
    { "src": "/logout", "dest": "/api/index" },
    { "src": "/editor/(.*)", "dest": "/api/index" },
    { "src": "/social", "dest": "/api/index" },
    { "src": "/faq", "dest": "/api/index" },
    { "src": "/seo", "dest": "/api/index" },
    { "src": "/upload", "dest": "/api/index" },
    { "src": "/preview/(.*)", "dest": "/api/index" },
    { "src": "/api/(.*)", "dest": "/api/index" },
    { "src": "/", "dest": "/index.html" }
  ]
}
